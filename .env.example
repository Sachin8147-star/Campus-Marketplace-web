# ==============================================================================
# CAMPUS CRATE - ENVIRONMENT CONFIGURATION
# ==============================================================================

# ------------------------------------------------------------------------------
# FRONTEND CONFIGURATION (Vercel & Website & APK)
# These variables start with VITE_ and are bundled into the frontend client.
# When deploying to Vercel, add these under Project Settings -> Environment Variables.
# ------------------------------------------------------------------------------

# Live backend URL shared by both the Website and Android APK:
VITE_API_BASE_URL="https://campuscrate-api-1jcb.onrender.com"

# Clerk Publishable Key for Student Authentication:
# Pre-filled with your live Clerk key. You can also replace with your custom key from dashboard.clerk.com
VITE_CLERK_PUBLISHABLE_KEY="pk_test_bW9kZXJuLWZlcnJldC05NTY0LmNsZXJrLmFjY291bnRzLmRldiQ"

# Optional Clerk Proxy URL (leave blank unless using a custom Clerk domain proxy)
VITE_CLERK_PROXY_URL=""

# Optional mobile push notifications flag (false by default)
VITE_ENABLE_PUSH="false"


# ------------------------------------------------------------------------------
# BACKEND CONFIGURATION (Live on Render / Optional for Local Backend)
# Note: Your backend is already live on Render with these settings.
# Only fill these if you want to run the backend locally on your own computer.
# ------------------------------------------------------------------------------

# PostgreSQL Database URL:
DATABASE_URL="postgresql://user:password@host:5432/dbname"

# Random secret key for session encryption:
SESSION_SECRET="campuscrate-super-secret-key-change-in-production"

# Clerk Secret Key (from Clerk Dashboard -> API Keys):
CLERK_SECRET_KEY="sk_test_YOUR_CLERK_SECRET_KEY"
CLERK_PUBLISHABLE_KEY="pk_test_bW9kZXJuLWZlcnJldC05NTY0LmNsZXJrLmFjY291bnRzLmRldiQ"

# Supabase Storage for Photo & Video Uploads:
SUPABASE_URL="https://ycyxholnocegndbdsytp.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="YOUR_SUPABASE_SERVICE_ROLE_KEY"
SUPABASE_STORAGE_BUCKET="campus-listings"

# Admin Panel credentials (/api/admin/):
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="ChangeThisPassword123!"

# Local API Server Port (5000 by default):
PORT="5000"
